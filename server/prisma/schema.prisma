// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

//---------------------------------------------------------------------------
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 3 — Real authenticated users, replacing DevRequester.
// role: which of the 3 permitted roles this user has.
// isActive: inactive users cannot authenticate (BR-01, BR-07).
// mustChangePassword: true right after creation or an admin password reset;
// blocks normal app access until a new password is saved (BR-02).
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ticketsRequested   Ticket[]        @relation("TicketRequester")
  ticketsOwned       Ticket[]        @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]

  // Lab 4
  actionsCreated     ActionTaken[]        @relation("ActionCreatedBy")
  actionsAssigned    ActionTaken[]        @relation("ActionAssignee")
  actionsPerformed   ActionTaken[]        @relation("ActionPerformedBy")
  statusChanges      TicketStatusChange[]

  @@index([role])
}

// Kept temporarily so the Lab 2 → Lab 3 migration has a documented source
// table to read from. Removed once the data migration script has run and
// been verified (see docs/lab-03/specification.md, Section 7).
model DevRequester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Lab 3 — full workflow statuses (Section 4.5 of the lab sheet).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique

  requesterId       Int
  requester         User         @relation("TicketRequester", fields: [requesterId], references: [id])

  ownerId           Int?
  owner             User?        @relation("TicketOwner", fields: [ownerId], references: [id])

  categoryId        Int
  category          Category     @relation(fields: [categoryId], references: [id])
  relatedSystemId   Int
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  summary           String
  description       String
  requestedPriority Priority
  itPriority        Priority
  currentStatus     TicketStatus @default(NEW)

  // Set by a Requester (FR-07); does not change currentStatus (BR-05).
  requesterMarkedResolved Boolean @default(false)

  // Lab 4 — when the Requester last marked the problem as appearing resolved (BR-19).
  requesterMarkedResolvedAt DateTime?
  // Lab 4 — optimistic concurrency (BR-22): incremented on every workflow update.
  version           Int          @default(1)
  // Lab 4 — set when the Ticket enters RESOLVED / CLOSED (BR-18).
  resolvedAt        DateTime?
  closedAt          DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]
  actionsTaken      ActionTaken[]
  statusChanges     TicketStatusChange[]

  @@index([requesterId])
  @@index([ownerId])
  @@index([currentStatus])
  @@index([currentStatus, ownerId])
  @@index([requesterId, currentStatus])
  @@index([updatedAt])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])
  storedFileName   String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removalReason    String?

  @@index([ticketId])
}

// Lab 3 — visible to Requester, IT Staff, Administrator (BR-04). Append-only.
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Lab 3 — visible only to IT Staff and Administrator (BR-04). Append-only.
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Lab 4 — Actions Taken (BR-01..BR-13). One Ticket has many Actions Taken.
// Append-only: never deleted; COMPLETED and CANCELLED are final (BR-12).
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actionAt         DateTime     @default(now())
  description      String       @db.VarChar(2000)
  result           String?      @db.VarChar(2000)
  status           ActionStatus @default(PLANNED)
  followUpRequired Boolean      @default(false)
  followUpNote     String?      @db.VarChar(1000)
  attachmentNotes  String?      @db.VarChar(500)

  createdById      Int
  createdBy        User         @relation("ActionCreatedBy", fields: [createdById], references: [id])
  assigneeId       Int
  assignee         User         @relation("ActionAssignee", fields: [assigneeId], references: [id])
  // Set automatically to the user who completes the action (BR-05).
  performedById    Int?
  performedBy      User?        @relation("ActionPerformedBy", fields: [performedById], references: [id])

  // Duplicate-submit protection (BR-23).
  idempotencyKey   String?      @db.VarChar(64)
  // Optimistic concurrency (BR-22).
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([createdById, ticketId, idempotencyKey])
  @@index([ticketId, actionAt, id])
  @@index([assigneeId, status])
}

// Lab 4 — append-only Ticket status history (BR-21).
model TicketStatusChange {
  id         Int          @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  fromStatus TicketStatus
  toStatus   TicketStatus
  actorId    Int
  actor      User         @relation(fields: [actorId], references: [id])
  reason     String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())

  @@index([ticketId, createdAt])
}
